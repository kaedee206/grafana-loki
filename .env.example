# ============================================================
# MONITORING STACK - ENVIRONMENT VARIABLES
# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit file .env vào git!
# ============================================================

# ---- GRAFANA ----
GRAFANA_ADMIN_USER=admin
# Đặt mật khẩu mạnh: chữ hoa, chữ thường, số, ký tự đặc biệt
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
# Sinh ngẫu nhiên: openssl rand -base64 32
GRAFANA_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_HERE
GRAFANA_ROOT_URL=https://your-domain.com

# ---- PROMETHEUS BASIC AUTH (cho web.yml) ----
# Hash mật khẩu bằng: htpasswd -nBC 10 "" | tr -d ':\n'
PROMETHEUS_BASIC_AUTH_USER=prometheus
PROMETHEUS_BASIC_AUTH_HASH=CHANGE_ME_BCRYPT_HASH_HERE

# ---- EMAIL/SMTP ----
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=your-email@gmail.com

# ---- ALERTMANAGER - TELEGRAM ----
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
TELEGRAM_CHAT_ID=CHANGE_ME_CHAT_ID

# ---- ALERTMANAGER - DISCORD ----
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME

# ---- ALERTMANAGER - EMAIL ----
ALERTMANAGER_SMTP_HOST=smtp.gmail.com:587
ALERTMANAGER_SMTP_FROM=alerts@your-domain.com
ALERTMANAGER_SMTP_AUTH_USER=your-email@gmail.com
ALERTMANAGER_SMTP_AUTH_PASS=your-app-password
ALERTMANAGER_EMAIL_TO=admin@your-domain.com
